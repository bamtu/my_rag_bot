JOPLIN_TOKEN=your_joplin_webclipper_token

# (선택) 특정 노트(들)만 인덱싱. 콤마로 여러 ID 지정 가능. 미설정 시 전체 노트.
TARGET_NOTE_IDS=77a9ba0ee62742ca96fb5f27e245d70b,abc1234...

OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Embedding 백엔드 — "openai" 또는 "huggingface"
# huggingface 사용 시 EMBEDDING_MODEL은 HF 모델 ID (예: nlpai-lab/KURE-v1)
# 모델 변경 시 인덱스 전체 재구축 필요 (차원 다름)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=nlpai-lab/KURE-v1

# Retrieval (dense-only, Chroma cosine, plain top-k similarity)
# 비슷하지만 다른 정보(예: 기초 필수 vs 기초 선택)를 모두 보존하려면 K를 충분히 크게.
RETRIEVAL_K=20

# 사용량(SQLite) 사이드바를 볼 수 있는 사용자명 (auth_config.yaml 기준, 콤마 구분)
ADMIN_USERS=admin
