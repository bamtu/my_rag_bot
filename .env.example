JOPLIN_TOKEN=your_joplin_webclipper_token

# (선택) 특정 노트(들)만 인덱싱. 콤마로 여러 ID 지정 가능. 미설정 시 전체 노트.
TARGET_NOTE_IDS=77a9ba0ee62742ca96fb5f27e245d70b,abc1234...

OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval (dense-only, Chroma cosine, plain top-k)
RETRIEVAL_K=10

# 사용량(SQLite) 사이드바를 볼 수 있는 사용자명 (auth_config.yaml 기준, 콤마 구분)
ADMIN_USERS=admin
