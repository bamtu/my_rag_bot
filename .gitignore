.env
venv/
__pycache__/
*.pyc
*.pkl
.vscode/

# HuggingFace 모델 파일은 절대 git에 올리지 말 것 (수 GB)
# 기본 캐시는 ~/.cache/huggingface/ 라 자동으로 제외되지만, 혹시 모를 경우 대비
*.safetensors
.huggingface/
huggingface_cache/
**/models--*/

# auth_config.yaml은 절대 커밋 금지 (cookie key 노출 시 세션 위조 가능)
app/auth_config.yaml
.streamlit/
# data/는 기본적으로 무시하되, Streamlit Cloud 배포를 위해 chroma 인덱스는 트래킹
# (chroma 내부에 .pkl 파일이 있어서 last-match-wins로 다시 살림)
data/*
!data/chroma/
!data/chroma/**
